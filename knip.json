{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "server/vercel.ts",
    "scripts/*.mjs",
    "e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignore": [
    "src/components/ui/**"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "shadcn",
    "tailwindcss",
    "@fontsource/ibm-plex-sans",
    "circle-flags",
    "flag-icons"
  ]
}
