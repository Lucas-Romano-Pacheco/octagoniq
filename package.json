{
  "name": "octagoniq",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Hub de dados do UFC: eventos, cards, resultados, rankings oficiais, perfis e histórico de lutadores em tempo real.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "vercel-build": "node scripts/vercel-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-flags.mjs",
    "lint": "biome lint",
    "lint:arch": "depcruise src server shared --config .dependency-cruiser.cjs",
    "lint:dead": "knip",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD --verbose",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check": "npm run typecheck && npm run lint && npm run lint:arch && npm run lint:dead && npm run test:coverage"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.9.0",
    "@sentry/react": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-sync-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "circle-flags": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "echarts": "^6.1.0",
    "flag-icons": "^7.6.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "node-html-parser": "^9.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "satori": "^0.18.4",
    "sharp": "^0.34.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.42.1",
    "rolldown": "^1.2.14",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
