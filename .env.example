# Supabase (opcional): sem estas duas variáveis, os palpites ficam só no navegador.
# Painel do Supabase → Project Settings → API. A chave "anon" é pública (o RLS protege os dados).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
# Botão "Continuar com Google" (só depois de ativar o provedor Google no Supabase)
# VITE_SUPABASE_GOOGLE=1

# ---------- Observabilidade (tudo opcional; sem estas variáveis nada é carregado) ----------
# Sentry no navegador: erros de tela, consultas que falharam, navegação e Web Vitals.
# VITE_SENTRY_DSN=https://<chave>@o<org>.ingest.sentry.io/<projeto>
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Sentry no servidor (rotas /api).
# SENTRY_DSN=https://<chave>@o<org>.ingest.sentry.io/<projeto>
# SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry (traces das rotas /api e das chamadas a ESPN, UFC.com, Wikipedia...). Escolha um destino:
# OTEL_SERVICE_NAME=octagoniq-api
# New Relic (EUA; na UE use https://otlp.eu01.nr-data.net):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_HEADERS=api-key=<license key>
# Datadog (OTLP direto, sem agente). O endereço depende do site da conta (US1, EU1...): confira em
# https://docs.datadoghq.com/opentelemetry/setup/otlp_ingest/traces/ (padrão: https://otlp.<DD_SITE>/v1/traces)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp.datadoghq.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=dd-api-key=<api key>,compute_stats=true
# Datadog com Agent/Collector próprio, Grafana, Honeycomb, Jaeger local etc.:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
